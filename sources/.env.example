# Connection settings for docker-compose.yml AND for the generated load scripts / `generator load`.
# HOST is 127.0.0.1 rather than localhost on purpose: on Windows `localhost` resolves to IPv6 (::1) first, the
# compose ports are published on IPv4 only, and SQL Server clients then wait for a timeout instead of falling back.
#
# Copy to .env and edit (.env is git-ignored). Plain KEY=value lines: no quotes needed, no inline comments.
# A variable already set in your shell wins over this file.
#
# To load into a server you already have instead of the compose containers: change HOST/PORT/credentials
# below and run `uv run generator load --host` (uses psql / sqlcmd / mongoimport on this machine).

# ---- SQL Server ---------------------------------------------------------------------------------
# The SQL Server container only starts if you accept the Developer-edition EULA: set Y to accept.
ACCEPT_EULA=Y
SQLSERVER_HOST=127.0.0.1
# Host port for the compose container (1433 is usually taken by a local SQL Server).
SQLSERVER_PORT=1440
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=LabSources_2026!
SQLSERVER_DATABASE=labsources
SQLSERVER_MEMORY_MB=2048
# Optional: a full server name that replaces HOST,PORT (e.g. (localdb)\MSSQLLocalDB or host\instance).
# Leave USER empty to use Windows authentication.
SQLSERVER_SERVER=
# Folder with the CSV files AS THE SQL SERVER SEES IT (BULK INSERT reads on the server).
# The compose container sees ./data at /lab. For another server, copy data/csv/fruit_juice there and put its path here.
SQLSERVER_DATA_DIR=/lab/csv/fruit_juice

# ---- PostgreSQL ---------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=labsources
POSTGRES_DATABASE=labsources

# ---- MongoDB ------------------------------------------------------------------------------------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=labsources
MONGO_PASSWORD=labsources
MONGO_DATABASE=labsources
# Optional: a complete connection string (e.g. mongodb+srv://user:pass@cluster/) that replaces
# HOST/PORT/USER/PASSWORD. Do not put a database name in it: MONGO_DATABASE is used.
MONGO_URI=

